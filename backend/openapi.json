            "items" : {
              "enum" : [ "ALERGIA", "ANTICOAGULANTE", "DIABETES", "HIPERTENSAO", "CARDIOPATIA", "COAGULOPATIA", "GESTANTE", "BISFOSFONATOS", "REACAO_ANESTESIA" ],
