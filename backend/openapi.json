          "cidade" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "complemento" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
