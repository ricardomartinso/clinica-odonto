          "alergiasDescricao" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "alergico" : {
            "type" : [ "boolean", "null" ]
          },
          "cardiopatia" : {
            "type" : [ "boolean", "null" ]
          },
          "coagulopatia" : {
            "type" : [ "boolean", "null" ]
          },
          "diabetes" : {
            "type" : [ "boolean", "null" ]
          },
          "fumante" : {
            "type" : [ "boolean", "null" ]
          },
          "gestante" : {
            "type" : [ "boolean", "null" ]
          },
          "hipertensao" : {
            "type" : [ "boolean", "null" ]
          },
          "medicamentosEmUso" : {
            "maxLength" : 1000,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "observacoes" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "reacaoAnestesia" : {
            "type" : [ "boolean", "null" ]
          },
          "semanasGestacao" : {
            "format" : "int32",
            "maximum" : 42,
            "minimum" : 1,
            "type" : [ "integer", "null" ]
          },
          "usaAnticoagulante" : {
            "type" : [ "boolean", "null" ]
          },
          "usaBisfosfonatos" : {
            "type" : [ "boolean", "null" ]
          }
        },
        "type" : "object"
      },
      "DadosDoPaciente" : {
        "properties" : {
          "celular" : {
            "minLength" : 1,
            "pattern" : "\\d{10,11}",
            "type" : "string"
          },
          "cpf" : {
            "type" : [ "string", "null" ]
          },
          "dataNascimento" : {
            "format" : "date",
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "endereco" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/DadosEndereco"
            }, {
              "type" : "null"
            } ]
          },
          "nome" : {
            "maxLength" : 150,
            "minLength" : 0,
            "type" : "string"
          },
          "nomeSocial" : {
            "maxLength" : 150,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "observacoes" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "responsavel" : {
