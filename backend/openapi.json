            "format" : "uuid",
            "type" : "string"
          },
          "respostas" : {
            "$ref" : "#/components/schemas/DadosDaAnamnese"
          }
        },
        "required" : [ "alertas", "atualizadaEm", "pacienteId", "respostas" ],
        "type" : "object"
      },
